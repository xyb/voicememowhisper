# Audio / waveforms / embeddings anywhere in the tree.
# (Speaker-ID data lives under ~/.local/share/voicememowhisper/ by default,
# so no repo-local rules are needed; these are defensive in case someone
# points VOICE_MEMO_SPEAKER_* env vars back into the repo.)
*.m4a
*.wav
*.mp3
*.npy
*.npz
*.waveform

# Private push entry point (not for the public repo).
Makefile.local
